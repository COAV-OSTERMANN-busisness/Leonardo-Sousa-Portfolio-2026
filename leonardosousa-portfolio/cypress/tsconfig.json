{
    "compilerOptions": {
      "target": "ES2020",
      "lib": ["ES2020", "DOM"],
      "module": "Node16",
      "moduleResolution": "Node16",
      "types": ["cypress", "node"],
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true
    },
    "include": [
      "**/*.ts",
      "../cypress.config.ts"
    ]
